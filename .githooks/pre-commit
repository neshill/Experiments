#!/bin/sh
# Stamps the build number into index.html on every commit, so the version shown
# in the bottom-right of the title screen always matches a commit in the history.
# Build number = how many commits the repo will have after this one.
n=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
d=$(date '+%Y-%m-%d %H:%M')
tmp="$(git rev-parse --git-dir)/build-stamp.tmp"
sed -E "s/^const GAME_BUILD=\{n:[0-9]+,date:'[^']*'\};/const GAME_BUILD={n:$n,date:'$d'};/" index.html > "$tmp" && cat "$tmp" > index.html
git add index.html
